# Copy this file to .env and adjust values for your local machine.
# .env itself is gitignored — never commit real secrets.
#
# NOTE: unlike a hand-rolled Airflow docker-compose setup, Astro CLI generates
# its own docker-compose config and manages Fernet key / JWT secret / the
# admin UI user internally — you don't need AIRFLOW_UID, AIRFLOW__CORE__
# FERNET_KEY, AIRFLOW__API_AUTH__JWT_SECRET, or _AIRFLOW_WWW_USER_* for local
# dev with Astro. Only variables our project actually reads are listed below.

# --- MinIO (local S3-compatible storage, used only for local dev via
#     docker-compose.override.yml). Not real cloud credentials. ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- ChemProp (optional, Step 4) ---
# Path to a trained ChemProp checkpoint (.ckpt/.pt), reachable from inside the
# Airflow containers (e.g. mounted via docker-compose.override.yml).
# Leave empty to skip the optional prediction step gracefully (no checkpoint
# trained as part of this project — see include/chem/chemprop.py docstring).
CHEMPROP_CHECKPOINT_PATH=

# --- MS Teams notifications (Step 3 / Iteration 3) ---
# Power Automate Workflows webhook URL for the scientists' Teams channel.
# Not yet issued for this course. Leave empty: notifications become a no-op
# until a real webhook URL is provided.
MS_TEAMS_WEBHOOK_URL=
